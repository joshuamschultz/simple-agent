# Copy this file to .env and paste in the key for whichever provider you use.
#
#   cp .env.example .env && chmod 600 .env
#
# You only need ONE. The default provider is anthropic; switch with
# `python3 agent.py --provider openai`.
#
# This file wins over anything your shell exports, on purpose. A stale or
# mislabelled key in the environment otherwise fails silently.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Any other provider arcllm supports works the same way. Uncomment as needed.
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# Local models (ollama, vllm) need no key at all.
